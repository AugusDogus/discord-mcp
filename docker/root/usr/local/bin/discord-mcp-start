#!/bin/sh
set -eu
umask 077
cd /app
bun prepare.mjs
export BETTER_AUTH_URL="${DISCORD_MCP_URL%/}"
if [ -z "${KEY_PEPPER:-}" ]; then
  KEY_PEPPER="$(cat /data/secrets/key-pepper)"
fi
if [ -z "${BETTER_AUTH_SECRET:-}" ]; then
  BETTER_AUTH_SECRET="$(cat /data/secrets/auth-secret)"
fi
export KEY_PEPPER BETTER_AUTH_SECRET
bun migrate.mjs
# The Selkies desktop's Wayland display. Next is reachable only through nginx.
export WAYLAND_DISPLAY=wayland-0 DISPLAY=:0
export HOSTNAME=127.0.0.1 PORT=3100
# Discord's gateway requires Bun, including in the standalone server.
exec bun server.js
